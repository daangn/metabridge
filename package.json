{
  "name": "@metabridge/monorepo",
  "version": "0.0.0",
  "workspaces": [
    "cli",
    "plugins/*",
    "schema"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -t --all run build",
    "test": "yarn workspaces foreach -t --all run test",
    "changeset": "changeset",
    "changeset:version": "changeset version && yarn install --mode=update-lockfile && yarn install --immutable",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "^2.5.1",
    "typescript": "^4.6.2"
  },
  "packageManager": "yarn@4.8.1",
  "private": true
}
